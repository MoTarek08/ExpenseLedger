{
  "ObjectStorageSettings": {
    "Endpoint": "minio.local",
    "StorageProvider": 3, // MinIO
    "BucketName": "files",
    "UploadUrlLifeTimeInMinuites": 15,
    "FileLifeTimeInDays": 90,
    "Region": "us-east-1",
    "ForcePathStyle": true
  },

  "AccessTokenSettings": {
    "KeyId": "04575f7d-d1b0-4765-b732-91c47a191904",
    "Issuer": "localhost",
    "Audience": "client",
    "Lifetime": 15 // mins
  },

  "RefreshTokenSettings": {
    "LifeTimeInDays": 7
  },

  "RateLimiting": {
    "AuthenticatedUser": {
      "TokenLimit": 200,
      "TokensPerPeriod": 15,
      "ReplenishmentPeriodInSeconds": 2,
      "QueueLimit": 15,
      "QueueProcessingOrder": "OldestFirst",
      "AutoReplenishment": true
    },
    "Ip": {
      "TokenLimit": 400,
      "TokensPerPeriod": 25,
      "ReplenishmentPeriodInSeconds": 2,
      "QueueLimit": 25,
      "QueueProcessingOrder": "OldestFirst",
      "AutoReplenishment": true
    },
    "UnknownIp": {
      "TokenLimit": 500,
      "TokensPerPeriod": 30,
      "ReplenishmentPeriodInSeconds": 2,
      "QueueLimit": 30,
      "QueueProcessingOrder": "OldestFirst",
      "AutoReplenishment": true
    },
    "LoginIp": {
      "PermitLimit": 8,
      "WindowInSeconds": 60,
      "AutoReplenishment": true
    },
    "LoginUnknownIp": {
      "TokenLimit": 60,
      "TokensPerPeriod": 5,
      "ReplenishmentPeriodInSeconds": 5,
      "QueueLimit": 10,
      "QueueProcessingOrder": "OldestFirst",
      "AutoReplenishment": true
    },
    "RefreshIp": {
      "TokenLimit": 500,
      "TokensPerPeriod": 25,
      "ReplenishmentPeriodInSeconds": 3,
      "QueueLimit": 15,
      "QueueProcessingOrder": "OldestFirst",
      "AutoReplenishment": true
    },
    "RefreshUnknownIp": {
      "TokenLimit": 600,
      "TokensPerPeriod": 25,
      "ReplenishmentPeriodInSeconds": 3,
      "QueueLimit": 15,
      "QueueProcessingOrder": "OldestFirst",
      "AutoReplenishment": true
    },
    "LogoutAuthenticatedUser": {
      "PermitLimit": 15,
      "WindowInSeconds": 60,
      "AutoReplenishment": true
    },
    "Upload": {
      "PermitLimit": 10,
      "WindowInSeconds": 3600,
      "AutoReplenishment": true
    },
    "LoginConcurrency": {
      "PermitLimit": 200,
      "QueueLimit": 20,
      "QueueProcessingOrder": "OldestFirst"
    },
    "UploadConcurrency": {
      "PermitLimit": 200,
      "QueueLimit": 10,
      "QueueProcessingOrder": "OldestFirst"
    },
    "RegisterConcurrency": {
      "PermitLimit": 300,
      "QueueLimit": 20,
      "QueueProcessingOrder": "OldestFirst"
    },
    "RefreshConcurrency": {
      "PermitLimit": 200,
      "QueueLimit": 10,
      "QueueProcessingOrder": "OldestFirst"
    }
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],

    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },

    "WriteTo": [
      {
        "Name": "Console"
      },

      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "MinimumLevel": {
              "Default": "Information",
              "Override": {
                "Microsoft": "Error",
                "System": "Error"
              }
            },
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "D:\\Coding\\C#\\ASP .NET CORE\\RealProjects\\ExpenseLedger\\Server\\Logs\\log-.txt",
                  "rollingInterval": "Day",
                  "retainedFileCountLimit": 30
                }
              }
            ]
          }
        }
      }
    ],

    "Enrich": [ "WithMachineName" ]
  },

  "PiplelineMetrics": {
    "MaxRequestBodySizeInBytes": 1000000,
    "MaxRequestBufferSizeInBytes": 500000
  },
  "CorsConfiguration": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  }
}

