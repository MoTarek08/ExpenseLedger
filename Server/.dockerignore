# Ignore everything by default so Docker only receives backend build inputs.
**

# Docker build inputs.
!Dockerfile
!NuGet.config
!global.json
!ExpenseLedgerSolution.slnx
!src/
!src/**

# Keep secrets out of the build (they will be injected with compose via environment variables)
src/Host/appsettings.development.json

# Keep generated and local-only files out of the context.\
**/[Bb]in/
**/[Oo]bj/
**/.vs/
**/.vscode/
**/TestResults/
**/.nuget/
**/*.user
**/*.suo
**/*.pdb
